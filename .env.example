# Exorcist — environment variable template
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# -------------------------------------------------------------------
# Model provider selection
# Supported values: anthropic, openai, fake
# Use "fake" for offline testing and CI (no API key required).
# -------------------------------------------------------------------
MODEL_PROVIDER=anthropic

# -------------------------------------------------------------------
# Anthropic (Claude)
# Required when MODEL_PROVIDER=anthropic
# -------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -------------------------------------------------------------------
# OpenAI (GPT)
# Required when MODEL_PROVIDER=openai
# -------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# -------------------------------------------------------------------
# Optional: override the default model name for the chosen provider
# -------------------------------------------------------------------
# MODEL_NAME=claude-3-5-sonnet-latest

# -------------------------------------------------------------------
# Spending cap for the hosted public demo (USD cents)
# Set to 0 to disable live model calls entirely.
# -------------------------------------------------------------------
# PUBLIC_SPENDING_CAP_CENTS=500

# -------------------------------------------------------------------
# Judge credentials — give judges unlimited access to bypass the cap
# Format: comma-separated tokens
# -------------------------------------------------------------------
# JUDGE_TOKENS=your_judge_token_here
